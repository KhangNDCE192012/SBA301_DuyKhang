spring.application.name=A3NguyenDuyKhang_CE192012
server.port=8080
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=A3NguyenDuyKhang_CE192012;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=YOUR_SQL_SERVER_PASSWORD
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
hotel.staff.email=staff@fuminihotel.com
hotel.staff.password=CHANGE_THIS_STAFF_PASSWORD
jwt.secret=GENERATE_A_BASE64_256_BIT_SECRET
jwt.expiration=86400000
app.cors.allowed-origin=http://localhost:5173
