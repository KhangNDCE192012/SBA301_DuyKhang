                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerFullName\": \"Test Customer\",\n  \"telephone\": \"0901234567\",\n  \"emailAddress\": \"test.customer@example.com\",\n  \"customerBirthday\": \"2002-05-20\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/customer/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.customerId) pm.collectionVariables.set('customerId', body.data.customerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer login",
